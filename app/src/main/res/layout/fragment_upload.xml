<!-- 큰 프레임 -->
<androidx.constraintlayout.widget.ConstraintLayout android:id="@+id/cl_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintStart_toStartOf="parent"
    app:layout_constraintTop_toTopOf="parent"
    app:layout_constraintWidth_percent="0.9"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- 사진 영역 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_image_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="W,16:9"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintHeight_percent="0.8"
        app:layout_constraintBottom_toTopOf="@id/layoutPointColor"
        android:layout_marginBottom="10dp">

        <ImageView
            android:id="@+id/iv_image_big"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/rounded_image"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/img_detail_big_default"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTagContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@id/iv_image_big"
            app:layout_constraintStart_toStartOf="@id/iv_image_big"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_image_small"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="16dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_image"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/img_detail_small_default"
            app:layout_constraintDimensionRatio="W,16:9"
            app:layout_constraintStart_toStartOf="@id/iv_image_big"
            app:layout_constraintTop_toTopOf="@id/iv_image_big"
            app:layout_constraintWidth_percent="0.4" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutPointColor"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.08"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintTop_toBottomOf="@id/cl_image_container">


        <!-- 오늘의 포인트 색상 텍스트 -->
        <TextView
            android:id="@+id/textTodayColor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘의 포인트 색상"
            android:paddingEnd="10dp"
            android:textColor="@android:color/black"
            android:fontFamily="@font/ibm_extralight"
            android:textSize="16sp"
            android:layout_marginEnd="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- 색상 아이콘 -->
        <View
            android:id="@+id/viewColorIcon"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_detail_color_round"
            app:layout_constraintStart_toEndOf="@id/textTodayColor"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintDimensionRatio="1:1" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_hashtag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="0dp"
        android:paddingVertical="4dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutPointColor">

        <ImageButton
            android:id="@+id/btnHashtag"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:src="@drawable/btn_hashtag"
            android:background="@android:color/transparent"
            />

        <!-- 해시태그 영역과 + 버튼 -->
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/flow_hashtag_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            app:flow_horizontalGap="6dp"
            app:flow_verticalGap="5dp"
            app:flow_wrapMode="aligned"
            app:flow_horizontalAlign="start"
            app:layout_constraintStart_toEndOf="@id/btnHashtag"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>