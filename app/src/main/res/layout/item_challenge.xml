<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_horizontal"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="12dp">

    <!-- 제목 텍스트 -->
    <TextView
        android:id="@+id/challenge_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Lorem Ipsum"
        android:textSize="14sp"
        android:textColor="@android:color/black"
        android:fontFamily="@font/noto_regular"
        android:includeFontPadding="false"
        android:gravity="start"
        android:textAlignment="viewStart"
        android:paddingBottom="14dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- 왼쪽 네모 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_image_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="W,16:9"
        app:layout_constraintWidth_percent="0.48"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/challenge_title">

        <ImageView
            android:id="@+id/iv_image_big"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/rounded_image"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/img_detail_big_default"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTagContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@id/iv_image_big"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="@id/iv_image_big"
            app:layout_constraintTop_toTopOf="@id/iv_image_big"
            app:layout_constraintVertical_bias="0.0" />

        <ImageView
            android:id="@+id/iv_image_small"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rounded_image"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/img_detail_small_default"
            app:layout_constraintDimensionRatio="W,16:9"
            app:layout_constraintStart_toStartOf="@id/iv_image_big"
            app:layout_constraintTop_toTopOf="@id/iv_image_big"
            app:layout_constraintWidth_percent="0.4" />
    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_challenge_wrapper"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@+id/cl_image_container"
        app:layout_constraintBottom_toBottomOf="@+id/cl_image_container"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintDimensionRatio="9:16">

        <View
            android:id="@+id/gray_box"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rounded_gray_box"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/btn_challenge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="도전하기"
            android:textSize="16sp"
            android:background="@drawable/bg_challenge_btn_round"
            android:fontFamily="@font/noto_regular"
            android:includeFontPadding="false"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp"
            app:layout_constraintTop_toTopOf="@+id/gray_box"
            app:layout_constraintBottom_toBottomOf="@+id/gray_box"
            app:layout_constraintStart_toStartOf="@+id/gray_box"
            app:layout_constraintEnd_toEndOf="@+id/gray_box" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- 프로필 이미지 -->
    <ImageView
        android:id="@+id/profile_image"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/img_profile_default"
        android:scaleType="centerCrop"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/cl_image_container"
        app:layout_constraintStart_toStartOf="@id/cl_image_container"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <!-- 유저 이름 -->
    <TextView
        android:id="@+id/user_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="유저네임"
        android:textSize="12sp"
        android:gravity="center_vertical"
        android:layout_marginStart="6dp"
        android:textColor="@color/gray_dark"
        app:layout_constraintTop_toTopOf="@id/profile_image"
        app:layout_constraintBottom_toBottomOf="@id/profile_image"
        app:layout_constraintStart_toEndOf="@id/profile_image"/>

</androidx.constraintlayout.widget.ConstraintLayout>