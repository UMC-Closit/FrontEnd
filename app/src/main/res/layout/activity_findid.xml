<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- 상단 검은색 배경 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/header_background"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.2"
        android:background="@color/black"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- 뒤로 가기 버튼 -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintWidth_percent="0.12"
            app:layout_constraintDimensionRatio="1:1"
            android:background="@null"
            android:src="@drawable/ic_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="32dp"
            android:layout_marginStart="16dp"
            />


        <!-- 회원가입 제목 -->
        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find ID"
            android:fontFamily="@font/ibm_regular"
            android:textColor="@color/white"
            android:textSize="24sp"
            app:layout_constraintBottom_toBottomOf="@id/header_background"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"/>

        <TextView
            android:id="@+id/title3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find Password"
            android:fontFamily="@font/ibm_regular"
            android:textColor="@color/auth_gray_bright"
            android:textSize="24sp"
            app:layout_constraintBottom_toBottomOf="@id/header_background"
            app:layout_constraintStart_toEndOf="@id/title"
            android:layout_marginBottom="16dp"
            android:layout_marginStart="16dp"/>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <!-- 회원가입 폼 -->
    <ScrollView
        android:id="@+id/scrollview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_background"
        app:layout_constraintBottom_toTopOf="@id/btn_next"
        android:padding="16dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Email 입력 -->
            <TextView
                android:id="@+id/tv_email"
                android:text="email"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:fontFamily="@font/noto_regular"
                android:layout_marginBottom="7dp"
                app:layout_constraintTop_toTopOf="@id/cl_info"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"/>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_check_email"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintWidth_percent="1"
                app:layout_constraintDimensionRatio="8:1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_email"
                android:layout_marginTop="4dp">

                <EditText
                    android:id="@+id/et_email"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintHeight_percent="1"
                    app:layout_constraintDimensionRatio="5.5:1"
                    android:background="@drawable/edittext_rounded"
                    android:hint="email 입력"
                    style="@style/EditTextDefaultStyle"
                    android:padding="12dp"
                    android:textSize="16sp"
                    android:textColor="@color/auth_gray_dark"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/btn_check_email"
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    app:layout_constraintHeight_percent="1"
                    app:layout_constraintDimensionRatio="2:1"
                    android:gravity="center"
                    android:text="인증번호 전송"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:background="@drawable/bg_email_check"
                    app:layout_constraintStart_toEndOf="@id/et_email"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="@id/et_email"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- 인증번호 입력 -->
            <TextView
                android:id="@+id/tv_confirm_number"
                android:text="인증번호 입력"
                android:textSize="14sp"
                android:textColor="@color/black"
                android:layout_width="match_parent"
                android:layout_height="30dp"
                android:fontFamily="@font/noto_regular"
                android:layout_marginBottom="7dp"
                app:layout_constraintTop_toBottomOf="@id/cl_check_email"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="8dp"/>
            <EditText
                android:id="@+id/et_confirm_number"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:background="@drawable/edittext_rounded"
                android:hint="인증번호 입력"
                android:padding="12dp"
                android:textSize="16sp"
                android:textColor="@color/auth_gray_dark"
                app:layout_constraintTop_toBottomOf="@id/tv_confirm_number"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="12dp"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <!-- 아이디 찾기 버튼 -->
    <Button
        android:id="@+id/btn_next"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="6.5:1"
        android:text="Find ID"
        android:textSize="18sp"
        android:textColor="@color/white"
        android:gravity="center"
        android:backgroundTint="@color/black_button"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp" />
</androidx.constraintlayout.widget.ConstraintLayout>
