<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:paddingTop="12dp">

    <!-- 툴바 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_toolbar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/check_gray_bright"
        android:elevation="2dp"
        android:paddingVertical="10dp"
        app:layout_constraintHeight_percent="0.085"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:src="@drawable/ic_back_black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="16dp"
            android:text="도전하기"
            android:textColor="@color/black"
            android:textSize="20sp"
            app:layout_constraintStart_toEndOf="@id/iv_back"
            app:layout_constraintTop_toTopOf="@id/iv_back"
            app:layout_constraintBottom_toBottomOf="@id/iv_back" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 본문 컨테이너: cl_toolbar 아래에 배치 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/light_gray_bg"
        android:padding="12dp"
        app:layout_constraintTop_toBottomOf="@+id/cl_toolbar"
        app:layout_constraintBottom_toTopOf="">

        <!-- ========== 왼쪽 카드 ========== -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_left"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            app:layout_constraintWidth_percent="0.48"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/my_text"
            app:layout_constraintDimensionRatio="W,16:9">

            <!-- 필요하면 include로 바꿔도 OK: layout="@layout/item_upload" -->
            <ImageView
                android:id="@+id/iv_left_big"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:background="@drawable/rounded_image"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/img_detail_big_default"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent" />

            <!-- 좌측 오버레이(작은 이미지/뱃지 등) -->
            <ImageView
                android:id="@+id/iv_left_small"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/rounded_image"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/img_detail_small_default"
                app:layout_constraintStart_toStartOf="@id/iv_left_big"
                app:layout_constraintTop_toTopOf="@id/iv_left_big"
                app:layout_constraintWidth_percent="0.40"
                app:layout_constraintDimensionRatio="W,16:9" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 왼쪽 카드 하단 닉네임/도트 -->
        <ImageView
            android:id="@+id/dot_left"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/bg_timeline_circle_shape"
            app:layout_constraintStart_toStartOf="@id/cl_left"
            app:layout_constraintTop_toBottomOf="@id/cl_left" />

        <TextView
            android:id="@+id/tv_username_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="유저네임"
            android:textColor="@color/black"
            app:layout_constraintStart_toEndOf="@id/dot_left"
            app:layout_constraintTop_toTopOf="@id/dot_left"
            app:layout_constraintBottom_toBottomOf="@id/dot_left" />

        <!-- ========== 오른쪽 카드 ========== -->
        <ImageView
            android:id="@+id/iv_right"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/rounded_image"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/image_background"
            app:layout_constraintWidth_percent="0.48"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/my_text"
            app:layout_constraintDimensionRatio="W,16:9" />

        <ImageView
            android:id="@+id/dot_right"
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:layout_marginTop="6dp"
            android:src="@drawable/bg_timeline_circle_shape"
            app:layout_constraintStart_toStartOf="@id/iv_right"
            app:layout_constraintTop_toBottomOf="@id/iv_right" />

        <TextView
            android:id="@+id/tv_username_right"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="유저네임"
            android:textColor="@color/black"
            app:layout_constraintStart_toEndOf="@id/dot_right"
            app:layout_constraintTop_toTopOf="@id/dot_right"
            app:layout_constraintBottom_toBottomOf="@id/dot_right" />

    </androidx.constraintlayout.widget.ConstraintLayout>
    <!-- ========== 하단 정보 패널(두 카드의 더 낮은 쪽에 맞춤) ========== -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cl_info_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="18dp"
        app:cardUseCompatPadding="false"
        app:cardPreventCornerOverlap="true"
        app:layout_constraintTop_toBottomOf="@id/cl_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="20dp">

            <TextView
                android:id="@+id/tv_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="3월 6일 - 3월 9일"
                android:textSize="12sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tv_info_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="제목"
                android:textColor="@color/black"
                android:textSize="20sp"
                android:fontFamily="@font/ibm_semibold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_date" />

            <TextView
                android:id="@+id/tv_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Lorem ipsum dolor sit amet consectetur. Tempor facilisis massa imperdiet nibh ipsum ultrices in."
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_info_title" />

            <ImageButton
                android:id="@+id/btnUpload"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_upload"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tv_description"
                app:layout_constraintBottom_toBottomOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.constraintlayout.widget.ConstraintLayout>
