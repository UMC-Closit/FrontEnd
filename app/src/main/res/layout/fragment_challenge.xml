<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".ui.community.challenge.ChallengeFragment">

    <!-- 상단 바 (검은 배경) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/blackbackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@drawable/bg_leftcorner_black"
        android:paddingHorizontal="16dp"
        android:paddingBottom="12dp"
        android:paddingTop="32dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:text="챌린지"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:includeFontPadding="false"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <TextView
            android:id="@+id/tv_new_battle"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:text="새로운 배틀 생성"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/createButton"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 새로운 배틀 생성 버튼 (오른쪽 아래 배치) -->
        <ImageView
            android:id="@+id/createButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_arrow"
            android:paddingStart="6dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:contentDescription="배틀생성"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- RecyclerView 추가 -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/Challenge_recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        tools:listitem="@layout/item_challenge"
        app:layout_constraintTop_toBottomOf="@id/blackbackground"
        app:layout_constraintBottom_toBottomOf="parent"
        android:padding="4dp"
        android:clipToPadding="false"/>
</androidx.constraintlayout.widget.ConstraintLayout>
