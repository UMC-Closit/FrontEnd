<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cl_challenge_wrapper"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    app:layout_constraintDimensionRatio="H,9:16"
    app:layout_constraintWidth_percent="0.48"
    app:layout_constraintStart_toStartOf="parent"
    android:padding="4dp"
    xmlns:app="http://schemas.android.com/apk/res-auto">

        <ImageView
            android:id="@+id/iv_image_big"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/rounded_image"
            android:clipToOutline="true"
            app:layout_constraintDimensionRatio="9:16"
            android:scaleType="centerCrop"
            android:src="@drawable/img_detail_big_default"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTagContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@id/iv_image_big"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintStart_toStartOf="@id/iv_image_big"
            app:layout_constraintTop_toTopOf="@id/iv_image_big"
            app:layout_constraintVertical_bias="0.0" />

        <ImageView
            android:id="@+id/iv_image_small"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/rounded_image"
            android:clipToOutline="true"
            android:scaleType="centerCrop"
            android:src="@drawable/img_detail_small_default"
            app:layout_constraintDimensionRatio="W,16:9"
            app:layout_constraintStart_toStartOf="@id/iv_image_big"
            app:layout_constraintTop_toTopOf="@id/iv_image_big"
            app:layout_constraintWidth_percent="0.4" />
</androidx.constraintlayout.widget.ConstraintLayout>