<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:padding="8dp">

    <!-- 제목 및 좋아요/댓글 -->
    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:includeFontPadding="false"
        android:fontFamily="@font/noto_regular"
        android:text="배틀 제목"
        android:textAlignment="viewStart"
        android:textColor="@android:color/black"
        android:textSize="14sp"
        app:layout_constraintBottom_toTopOf="@+id/cl_image_container"
        app:layout_constraintStart_toStartOf="@+id/cl_image_container"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageView
        android:id="@+id/iv_like"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintWidth_percent="0.05"
        android:src="@drawable/ic_like_off_clg"
        app:layout_constraintTop_toTopOf="@+id/tv_title"
        app:layout_constraintBottom_toBottomOf="@+id/tv_title"
        app:layout_constraintEnd_toStartOf="@+id/view_margin"
        android:layout_marginEnd="4dp" />


    <View
        android:id="@+id/view_margin"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_like"
        app:layout_constraintEnd_toStartOf="@+id/iv_comment"
        app:layout_constraintTop_toTopOf="@+id/iv_like"
        app:layout_constraintWidth_percent="0.06" />

    <TextView
        android:id="@+id/tv_like_count"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0"
        android:fontFamily="@font/noto_regular"
        android:includeFontPadding="false"
        android:textColor="@color/gray_dark"
        android:textSize="12dp"
        app:layout_constraintBottom_toBottomOf="@+id/view_margin"
        app:layout_constraintStart_toEndOf="@+id/iv_like"
        app:layout_constraintStart_toStartOf="@+id/view_margin"
        app:layout_constraintTop_toTopOf="@+id/view_margin" />

    <ImageView
        android:id="@+id/iv_comment"
        android:layout_width="19dp"
        android:layout_height="18dp"
        android:src="@drawable/ic_comment_clg"
        app:layout_constraintBottom_toBottomOf="@+id/iv_like"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_like"
        app:layout_constraintWidth_percent="0.05" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_image_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="11dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_title">

        <!-- 이미지 두 개 나란히 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_image_left"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="W,16:9"
            app:layout_constraintWidth_percent="0.48"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/iv_left_big"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/rounded_image"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/img_detail_big_default"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clLeftTagContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@id/iv_left_big"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="@id/iv_left_big"
                app:layout_constraintTop_toTopOf="@id/iv_left_big"
                app:layout_constraintVertical_bias="0.0" />

            <ImageView
                android:id="@+id/iv_left_small"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/rounded_image"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/img_detail_small_default"
                app:layout_constraintDimensionRatio="W,16:9"
                app:layout_constraintStart_toStartOf="@id/iv_left_big"
                app:layout_constraintTop_toTopOf="@id/iv_left_big"
                app:layout_constraintWidth_percent="0.4" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cl_image_right"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintDimensionRatio="W,16:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.48">

            <ImageView
                android:id="@+id/iv_right_big"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:background="@drawable/rounded_image"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/img_detail_big_default"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clRightTagContainer"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintBottom_toBottomOf="@id/iv_right_big"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="@id/iv_right_big"
                app:layout_constraintTop_toTopOf="@id/iv_right_big"
                app:layout_constraintVertical_bias="0.0" />

            <ImageView
                android:id="@+id/iv_right_small"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/rounded_image"
                android:clipToOutline="true"
                android:scaleType="centerCrop"
                android:src="@drawable/img_detail_small_default"
                app:layout_constraintDimensionRatio="W,16:9"
                app:layout_constraintStart_toStartOf="@id/iv_right_big"
                app:layout_constraintTop_toTopOf="@id/iv_right_big"
                app:layout_constraintWidth_percent="0.4" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_vote"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.08"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_progress_total"
        android:clipToOutline="true"
        app:layout_constraintTop_toBottomOf="@+id/cl_image_container">

        <!-- 왼쪽 영역 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/left_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_progress_left"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/right_area">

            <ImageView
                android:id="@+id/iv_left_profile"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHeight_percent="0.6"
                android:layout_marginStart="8dp"
                android:src="@drawable/img_profile_default"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.5" />

            <TextView
                android:id="@+id/tv_left_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="unknown"
                android:textSize="13sp"
                android:layout_marginStart="4dp"
                android:fontFamily="@font/noto_regular"
                android:includeFontPadding="false"
                android:textColor="@color/black"
                app:layout_constraintStart_toEndOf="@id/iv_left_profile"
                app:layout_constraintTop_toTopOf="@id/iv_left_profile"
                app:layout_constraintBottom_toBottomOf="@id/iv_left_profile" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 오른쪽 영역 -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/right_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/bg_progress_right"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/left_area">

            <ImageView
                android:id="@+id/iv_right_profile"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constraintDimensionRatio="1:1"
                app:layout_constraintHeight_percent="0.6"
                android:src="@drawable/img_profile_default"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toStartOf="@id/tv_right_id"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintVertical_bias="0.5" />

            <TextView
                android:id="@+id/tv_right_id"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="unknown"
                android:textSize="13sp"
                android:layout_marginEnd="8dp"
                android:fontFamily="@font/noto_regular"
                android:includeFontPadding="false"
                android:textColor="@color/black"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/iv_right_profile"
                app:layout_constraintBottom_toBottomOf="@id/iv_right_profile" />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>