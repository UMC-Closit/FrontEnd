<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ll_history_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_calendar_divider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingVertical="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- 왼쪽 선 -->
        <View
            android:id="@+id/leftLine"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginEnd="8dp"
            android:background="#BDBDBD"
            app:layout_constraintBottom_toBottomOf="@id/tvYear"
            app:layout_constraintEnd_toStartOf="@id/tvYear"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvYear" />

        <!-- 텍스트 -->
        <TextView
            android:id="@+id/tvYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/noto_light"
            android:includeFontPadding="false"
            android:text="20XX"
            android:textColor="@color/history_gray"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/rightLine"
            app:layout_constraintStart_toEndOf="@id/leftLine"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 오른쪽 선 -->
        <View
            android:id="@+id/rightLine"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginStart="8dp"
            android:background="#BDBDBD"
            app:layout_constraintBottom_toBottomOf="@id/tvYear"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/tvYear"
            app:layout_constraintTop_toTopOf="@id/tvYear" />

    </androidx.constraintlayout.widget.ConstraintLayout>


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/cl_calendar_divider">

        <!-- 월 선택 -->
        <TextView
            android:id="@+id/tv_month"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingVertical="3dp"
            android:text="XX월"
            android:textColor="@color/black"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- 색상 표시 동그라미 -->
        <View
            android:id="@+id/view_color_circle"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_history_pointcolor"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintHeight_percent="0.7"
            app:layout_constraintStart_toEndOf="@id/tv_month"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- 요일 표시 -->
    <LinearLayout
        android:id="@+id/ll_weekdays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:orientation="horizontal"
        android:paddingVertical="4dp"
        app:layout_constraintTop_toBottomOf="@id/cl_title">

        <TextView
            android:id="@+id/tv_sun"
            style="@style/WeekdayTextStyle"
            android:text="sun" />

        <TextView
            android:id="@+id/tv_mon"
            style="@style/WeekdayTextStyle"
            android:text="mon" />

        <TextView
            android:id="@+id/tv_tue"
            style="@style/WeekdayTextStyle"
            android:text="tue" />

        <TextView
            android:id="@+id/tv_wed"
            style="@style/WeekdayTextStyle"
            android:text="wed" />

        <TextView
            android:id="@+id/tv_thu"
            style="@style/WeekdayTextStyle"
            android:text="thurs" />

        <TextView
            android:id="@+id/tv_fri"
            style="@style/WeekdayTextStyle"
            android:text="fri" />

        <TextView
            android:id="@+id/tv_sat"
            style="@style/WeekdayTextStyle"
            android:text="sat" />
    </LinearLayout>

    <!-- 캘린더 RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_calendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:overScrollMode="never"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:layout_constraintTop_toBottomOf="@+id/ll_weekdays"
        app:spanCount="7"
        tools:listitem="@layout/item_calendar_day" />

</androidx.constraintlayout.widget.ConstraintLayout>