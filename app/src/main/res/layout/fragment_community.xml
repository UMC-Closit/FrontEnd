<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_community_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingTop="20dp"
    android:background="@color/white"
    tools:context=".ui.community.CommunityFragment">

    <!-- Search Bar Container -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_container_community"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintWidth_percent="0.9"
        app:layout_constraintDimensionRatio="9:1"
        android:layout_margin="10dp"
        android:background="@drawable/lookup_background"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/img_search_icon_community"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintHeight_percent="0.5"
            app:layout_constraintDimensionRatio="1:1"
            android:layout_marginStart="10dp"
            android:src="@drawable/search"
            android:contentDescription="Search Icon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <EditText
            android:id="@+id/et_search_community"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="search"
            android:background="@null"
            android:fontFamily="@font/ibm_regular"
            android:textColor="@color/gray_dark"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            app:layout_constraintStart_toEndOf="@+id/img_search_icon_community"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- "오늘의 옷장" 타이틀 및 업로드 버튼 컨테이너 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_today_closet_title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/search_container_community">

        <TextView
            android:id="@+id/tv_today_closet_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:includeFontPadding="false"
            android:text="오늘의 옷장"
            android:fontFamily="@font/noto_regular"
            android:textSize="16sp"
            android:textColor="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <ImageButton
            android:id="@+id/btn_upload_today_closet"
            android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/ic_community_upload"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="오늘의 옷장 업로드 버튼"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/tv_today_closet_title"
        app:layout_constraintBottom_toBottomOf="@id/tv_today_closet_title" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- "오늘의 옷장" RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_community_today_closet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:paddingStart="20dp"
        android:paddingEnd="10dp"
    android:clipToPadding="false"
    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
    app:layout_constraintTop_toBottomOf="@id/cl_today_closet_title_container"
    tools:listitem="@layout/item_community_today_closet"
    tools:itemCount="5" /> <!-- 디자인 타임 미리보기용 아이템 개수 -->


    <!-- "배틀 게시판" 타이틀 및 업로드 버튼 컨테이너 -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_battle_post_title_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        app:layout_constraintTop_toBottomOf="@id/rv_community_today_closet">

        <TextView
            android:id="@+id/tv_battle_post_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:text="배틀 게시판"
            android:includeFontPadding="false"
            android:fontFamily="@font/noto_regular"
            android:textSize="16sp"
            android:textColor="@color/black"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <ImageButton
            android:id="@+id/btn_upload_battle_post"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:layout_marginEnd="10dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="배틀 게시판 업로드 버튼"
            android:src="@drawable/ic_community_upload"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_battle_post_title"
            app:layout_constraintBottom_toBottomOf="@id/tv_battle_post_title"/>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- "배틀 게시판" RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_community_battle_post"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="10dp"
        android:paddingStart="20dp"
        android:paddingEnd="10dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
        app:layout_constraintTop_toBottomOf="@id/cl_battle_post_title_container"
        tools:listitem="@layout/item_community_battle_post"
        tools:itemCount="4" /> <!-- 디자인 타임 미리보기용 아이템 개수 -->

</androidx.constraintlayout.widget.ConstraintLayout>